<resources>
    <!-- Window theme only; all UI colours come from core/theme/AxoTheme (Compose). -->
    <style name="Theme.MyForthing" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch theme: dark like the launcher icon in both modes, kept on screen until the saved theme and
         the start destination are loaded, so "Schwarz" never starts with a light window. -->
    <style name="Theme.MyForthing.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyForthing</item>
    </style>
</resources>
