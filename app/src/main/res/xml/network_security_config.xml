<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext anywhere except the recorder's media server (HTTP port 80 on its fixed Wi-Fi address).
     The TCP control channel (7878) and RTSP (554) are not HTTP and are not affected by this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.42.1</domain>
    </domain-config>
</network-security-config>
