<resources>
    <!-- Window theme only; all UI colours come from core/theme/AxoTheme (Compose). -->
    <style name="Theme.MyForthing" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Launch theme: dark in both modes, kept on screen until the saved theme and the start destination are loaded,
         so "Schwarz" never starts with a light window. The lion sits on a light disc, as on the launcher. -->
    <style name="Theme.MyForthing.Starting" parent="Theme.SplashScreen.IconBackground">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MyForthing</item>
    </style>
</resources>
